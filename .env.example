# ---- Docker Compose (docker compose up / pnpm stack:*) ----
# Обязательные. Сгенерировать: openssl rand -hex 32 / openssl rand -base64 32
# POSTGRES_PASSWORD только hex (openssl rand -hex 32): символы / + = из base64 ломают DATABASE_URL.
POSTGRES_PASSWORD=
# Пароль Redis (кэш и лимиты входа), только hex: openssl rand -hex 32
REDIS_PASSWORD=
# Демо-профиль (pnpm stack:demo): пароль read-only пользователя демо-БД, только hex: openssl rand -hex 16
DEMO_DB_PASSWORD=
# Хранилище файлов шаблонов и отчётов — SeaweedFS (S3, сервис s3). Единственная учётная запись S3:
# её создаёт сервис s3 при старте, её же используют api и backup. Только hex: openssl rand -hex 16 / -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Токен агента бэкапа (сервис backup; управление бэкапами в админке), не короче 32 символов: openssl rand -hex 32
BACKUP_AGENT_TOKEN=
# Имя бакета, по умолчанию carbone-reports; API создаёт его при первом старте
# S3_BUCKET=carbone-reports
# Готовые образы из GHCR (см. README «Запуск из готовых образов»); пусто — локальная сборка
# API_IMAGE=ghcr.io/samrozhkov/carbone-report-api:latest
# WEB_IMAGE=ghcr.io/samrozhkov/carbone-report-web:latest
# BACKUP_IMAGE=ghcr.io/samrozhkov/carbone-report-backup:latest
# Порты прод-режима
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Порты режима разработки
WEB_DEV_PORT=8080
POSTGRES_DEV_PORT=55433
# APP_SECRET, ENCRYPTION_KEY, ONLYOFFICE_JWT_SECRET, ADMIN_LOGIN, ADMIN_PASSWORD — см. ниже, тоже обязательны.
# DATABASE_URL, STORAGE_BACKEND, S3_ENDPOINT, *_URL в Docker задаёт docker-compose.yml; значения ниже — для запуска API на хосте.

# БД приложения
DATABASE_URL=postgres://app:app@localhost:5432/app
# openssl rand -hex 32
APP_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32 — тот же секрет задаётся JWT_SECRET у OnlyOffice
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
API_INTERNAL_URL=http://api:3000
CARBONE_URL=http://carbone:4000
# Redis: общий кэш шаблонов Carbone и лимит попыток входа. Если Redis недоступен,
# API работает без него (кэш промахивается, лимит не применяется). В Docker адрес с паролем
# (redis://:<REDIS_PASSWORD>@redis:6379) задаёт docker-compose.yml.
# REDIS_URL=redis://:<пароль>@localhost:6379
# Прокси перед API (X-Forwarded-For): 1 — nginx в compose. Ещё один прокси перед nginx — 2.
# TRUSTED_PROXY_HOPS=1
# Управление бэкапами из админки: адрес агента и тот же BACKUP_AGENT_TOKEN. Без адреса функция выключена.
# В Docker задаёт docker-compose.yml (http://backup-agent:8080, только внутренняя сеть backup); порт агента наружу не публикуется.
# BACKUP_AGENT_URL=
ADMIN_LOGIN=admin
# не короче 8 символов
ADMIN_PASSWORD=
# Вход через LDAP/Active Directory (опционально). Если выключен — только локальный admin/password.
# Если включён, но связка логин/пароль не подтверждена сервером (неверный пароль, LDAP недоступен),
# API откатывается на локальную проверку пароля — это не ломает встроенного admin при сбое LDAP.
LDAP_ENABLED=false
# LDAP_URL=ldaps://dc.example.local:636
# Сервисная учётная запись для поиска пользователя (пусто — анонимный поиск, если сервер его разрешает)
# LDAP_BIND_DN=cn=svc-carbone,ou=service,dc=example,dc=local
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=example,dc=local
# %s — подставляемый логин (все вхождения). AD: (sAMAccountName=%s), OpenLDAP: (uid=%s)
# LDAP_USER_FILTER=(uid=%s)
# Роль, которую получает новый пользователь при первом успешном входе через LDAP
# LDAP_DEFAULT_ROLE=user
# false — разрешить самоподписанный сертификат сервера LDAP (ldaps://)
# LDAP_TLS_REJECT_UNAUTHORIZED=true

# Хранилище файлов: local — каталог STORAGE_DIR; s3 — бакет S3 (SeaweedFS, AWS и др.)
STORAGE_BACKEND=local
STORAGE_DIR=./.data
# Для s3 обязательны S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (ключи — выше). S3_ENDPOINT пуст — AWS S3.
# Адрес — ваше доступное S3-хранилище: compose порт 8333 сервиса s3 наружу не публикует,
# поэтому localhost:8333 работает, только если вы сами запустили S3 на этом порту.
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# SeaweedFS — true
# S3_FORCE_PATH_STYLE=false
# true — создать бакет при старте, если его нет; иначе API не запускается
# S3_CREATE_BUCKET=false
# Папка с миграциями (необязательно; по умолчанию ./drizzle относительно текущей директории)
# MIGRATIONS_DIR=./drizzle
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=100000
RENDER_TIMEOUT_MS=120000
# Общий срок формирования отчёта и предпросмотра, мс: проверка параметров, SQL и Carbone вместе.
# При превышении — ошибка 504. По умолчанию 120000
# REPORT_TIMEOUT_MS=120000
REPORT_RETENTION_DAYS=30
TZ=Europe/Moscow
PORT=3000
COOKIE_SECURE=false

# Бэкап (сервис backup запускается вместе со стеком; бэкапы и восстановление — в админке, «Бэкапы»):
# расписание cron в часовом поясе TZ, сколько обычных копий хранить (pre-restore-* — всегда 3), каталог на хосте
# BACKUP_CRON=0 3 * * *
# BACKUP_KEEP=14
# BACKUP_DIR=./backups
# Предельное время pg_dump и архивации файлов, с; при превышении копия остаётся .partial. По умолчанию 3600
# BACKUP_TIMEOUT=3600
