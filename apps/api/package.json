{
  "name": "@carbone-reports/api",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts && pnpm run test:int:s3",
    "test:int:s3": "TEST_STORAGE_BACKEND=s3 vitest run --config vitest.int.config.ts test/templates.int.test.ts test/onlyoffice.int.test.ts test/run-files.int.test.ts test/cleanup.int.test.ts test/hardening.int.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@carbone-reports/carbone": "workspace:*",
    "@carbone-reports/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@smithy/node-http-handler": "^4.12.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
