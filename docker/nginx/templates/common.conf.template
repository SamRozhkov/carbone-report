root /usr/share/nginx/html;

# Резолвер — первый nameserver из /etc/resolv.conf (15-carbone-reports.envsh): встроенный DNS Docker
# в compose, DNS кластера в k8s. Адреса api и onlyoffice перерезолвятся без перезапуска nginx.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# Маршруты для Document Server доступны только во внутренней сети.
location = /internal { return 404; }
location /internal/ { return 404; }

location /api/ {
    # Закодированные %2F..%2F обходят блок /internal: nginx выбирает location по нормализованному URI,
    # а в api уходит исходный. Пропускаем только запросы, чей исходный путь начинается с /api/.
    if ($request_uri !~ "^/api/") { return 404; }

    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    # Fastify доверяет X-Forwarded-Host (req.hostname): значение клиента подменяем своим.
    proxy_set_header X-Forwarded-Host $host;
    client_max_body_size 25m;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_intercept_errors off;
    error_page 502 503 504 = @api_unavailable;
    error_page 413 = @too_large;
    # add_header в location отменяет наследование из server: HSTS передаём переменной $hsts.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security $hsts always;
}

location /onlyoffice/ {
    set $oo_upstream ${ONLYOFFICE_UPSTREAM};
    rewrite ^/onlyoffice/(.*)$ /$1 break;
    proxy_pass $oo_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-Host $http_host/onlyoffice;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Сессия админа не должна уходить в Document Server.
    proxy_set_header Cookie "";
    client_max_body_size 100m;
    proxy_read_timeout 300s;
}

location @api_unavailable {
    default_type application/json;
    return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"сервис временно недоступен"}}';
}

location @too_large {
    default_type application/json;
    return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"тело запроса слишком большое"}}';
}

# Хешированные ассеты Vite — кэшируем навсегда.
location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
}

# Браузер сам запрашивает /favicon.ico; иконка — /favicon.svg, index.html вместо неё не отдаём.
location = /favicon.ico { return 404; }

location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
}
