{
  "name": "carbone-reports",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:int": "pnpm -r test:int",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "chart:check": "sh scripts/chart.sh all",
    "format": "prettier --write .",
    "stack:prod": "docker compose up -d --build",
    "stack:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "stack:demo": "docker compose --profile demo up -d --build --wait && pnpm demo:seed",
    "demo:seed": "tsx scripts/demo-seed.ts --insecure --wait",
    "stack:down": "docker compose --profile demo -f docker-compose.yml -f docker-compose.dev.yml down",
    "stack:smoke": "tsx scripts/smoke.ts",
    "help:check": "tsx scripts/help-check.ts",
    "e2e": "pnpm --filter @carbone-reports/e2e e2e"
  },
  "devDependencies": {
    "@carbone-reports/carbone": "workspace:*",
    "@carbone-reports/shared": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
